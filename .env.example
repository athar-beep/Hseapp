# GEMINI_API_KEY: Required for server-side Gemini AI Mock Interview & Learning Coach evaluations.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION
# VITE_* values are public client settings protected by RLS.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-public-anon-key"

# Server-only settings. NEVER prefix these with VITE_ and never expose them to the browser.
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-public-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-server-only-service-role-key"

# No shared admin passcode is used. Assign admin role through a trusted database operator process.
